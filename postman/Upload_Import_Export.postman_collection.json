                  "pm.test('has image payload fields', () => {",
                  "  const d = pm.response.json().data;",
                  "  ['id','asset_id','image_url','image_type','file_name','file_size_kb','mime_type'].forEach(k => pm.expect(d).to.have.property(k));",
