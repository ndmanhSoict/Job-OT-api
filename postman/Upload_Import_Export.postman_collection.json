{
  "info": {
    "name": "LCMS-API – Upload & Import Export (Section 11 & 12)",
    "description": "Section 11: UPLOAD – images/documents and delete attachment endpoints\nSection 12: EXPORT / IMPORT – template, import xlsx, export excel/csv, export pdf\n\nChạy theo thứ tự trong folder. Nếu chưa có asset test thì chạy request tạo asset đầu tiên.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "staff_token",
      "value": "REPLACE_WITH_STAFF_JWT"
    },
    {
      "key": "admin_token",
      "value": "REPLACE_WITH_ADMIN_JWT"
    },
    {
      "key": "created_asset_id",
      "value": ""
    },
    {
      "key": "uploaded_image_id",
      "value": ""
    },
    {
      "key": "uploaded_document_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup Asset",
      "item": [
        {
          "name": "POST Create Asset – for upload/import-export tests",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "const id = pm.response.json().data?.id;",
                  "if (id) pm.collectionVariables.set('created_asset_id', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_type\": \"trademark\",\n  \"title\": \"Asset test upload Postman\",\n  \"application_number\": \"TM-UPLOAD-POSTMAN-001\",\n  \"application_date\": \"2024-01-10\",\n  \"publication_date\": \"2024-03-01\",\n  \"grant_date\": \"2024-06-20\",\n  \"expiry_date\": \"2034-06-20\",\n  \"status\": \"granted\",\n  \"applicant_name\": \"Cong ty Test Upload\",\n  \"province_code\": \"BN\",\n  \"district_code\": \"BN001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/ip-assets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ip-assets"
              ]
            }
          }
        }
      ]
    },
