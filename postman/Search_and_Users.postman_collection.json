        {
          "name": "7.2 POST Create User – success (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('Has UUID id', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "});",
                  "pm.test('no password_hash in response', () => {",
                  "  pm.expect(pm.response.json().data).to.not.have.property('password_hash');",
                  "});",
                  "pm.test('is_active = true by default', () => {",
                  "  pm.expect(pm.response.json().data.is_active).to.be.true;",
                  "});",
                  "pm.test('role = staff', () => {",
                  "  pm.expect(pm.response.json().data.role).to.equal('staff');",
                  "});",
                  "// Save ID for subsequent tests",
                  "const id = pm.response.json().data?.id;",
                  "if (id) pm.collectionVariables.set('created_user_id', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
