                "exec": [
                  "// Lấy Admin ID từ JWT: decode payload base64 (phần giữa của token)",
                  "const token = pm.collectionVariables.get('admin_token');",
                  "if (token && token !== 'REPLACE_WITH_ADMIN_JWT') {",
                  "  try {",
                  "    const payload = JSON.parse(atob(token.split('.')[1]));",
                  "    pm.collectionVariables.set('admin_user_id', payload.sub);",
                  "  } catch(e) {}",
                  "}"
                ]
              }
