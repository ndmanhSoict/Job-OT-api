      "name": "6. SEARCH",
      "item": [
        {
          "name": "6.1 GET Search – success (q=nhãn hiệu)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('success = true', () => {",
                  "  pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "",
                  "pm.test('data is array', () => {",
                  "  pm.expect(pm.response.json().data).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('meta has pagination fields', () => {",
                  "  const meta = pm.response.json().meta;",
                  "  pm.expect(meta).to.have.all.keys('page', 'limit', 'total', 'totalPages');",
                  "});",
                  "",
                  "pm.test('facets has asset_type and status', () => {",
                  "  const facets = pm.response.json().facets;",
                  "  pm.expect(facets).to.have.property('asset_type');",
                  "  pm.expect(facets).to.have.property('status');",
                  "});",
                  "",
                  "pm.test('each item has highlight field', () => {",
                  "  pm.response.json().data.forEach(item => {",
                  "    pm.expect(item).to.have.property('highlight');",
                  "    pm.expect(item.highlight).to.have.property('title');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/search?q=nhãn hiệu&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["search"],
              "query": [
                { "key": "q", "value": "nhãn hiệu" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
