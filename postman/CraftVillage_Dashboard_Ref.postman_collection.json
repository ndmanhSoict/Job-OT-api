          "name": "8.1 GET List – no auth (Guest)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('data is array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('meta has pagination', () => {",
                  "  const m = pm.response.json().meta;",
                  "  pm.expect(m).to.have.all.keys('page', 'limit', 'total', 'totalPages');",
                  "});",
                  "pm.test('each item has required fields', () => {",
                  "  pm.response.json().data.forEach(v => {",
                  "    pm.expect(v).to.have.property('id');",
                  "    pm.expect(v).to.have.property('village_name');",
                  "    pm.expect(v).to.have.property('district_code');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/craft-villages?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["craft-villages"],
              "query": [
