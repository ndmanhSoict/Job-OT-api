                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('has total (number)', () => {",
                  "  pm.expect(pm.response.json().data.total).to.be.a('number');",
                  "});",
                  "pm.test('by_type has all AssetType keys', () => {",
                  "  const bt = pm.response.json().data.by_type;",
                  "  ['copyright','gi','trademark','patent','design','craft'].forEach(k => {",
                  "    pm.expect(bt).to.have.property(k);",
                  "  });",
                  "});",
                  "pm.test('by_status exists', () => {",
                  "  pm.expect(pm.response.json().data.by_status).to.be.an('object');",
                  "});",
                  "pm.test('craft_villages_total is number', () => {",
                  "  pm.expect(pm.response.json().data.craft_villages_total).to.be.a('number');",
                  "});",
                  "pm.test('updated_at is ISO string', () => {",
                  "  pm.expect(pm.response.json().data.updated_at).to.match(/^\\d{4}-\\d{2}-\\d{2}T/);",
                  "});"
