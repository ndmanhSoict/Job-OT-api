                  "  const body = pm.response.json();",
                  "  body.data.forEach(item => {",
                  "    pm.expect(item.asset_type).to.equal('trademark');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
