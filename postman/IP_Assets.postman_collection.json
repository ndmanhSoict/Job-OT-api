{
  "info": {
    "name": "LCMS-API – IP Assets (Section 5)",
    "description": "Test collection for Section 5: IP ASSETS – Đối tượng SHTT (Base CRUD)\n\nEndpoints:\n- GET  /api/v1/ip-assets         (public)\n- GET  /api/v1/ip-assets/:id     (public)\n- POST /api/v1/ip-assets         (Staff+)\n- PATCH /api/v1/ip-assets/:id    (Staff+)\n- DELETE /api/v1/ip-assets/:id   (soft-delete, Staff+)\n- DELETE /api/v1/ip-assets/:id/hard (Admin)\n- POST /api/v1/ip-assets/:id/restore (Admin)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api/v1" },
    { "key": "staff_token", "value": "REPLACE_WITH_STAFF_JWT" },
    { "key": "admin_token", "value": "REPLACE_WITH_ADMIN_JWT" },
    { "key": "created_asset_id", "value": "" },
    { "key": "soft_deleted_asset_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Public Endpoints (Guest)",
      "item": [
        {
          "name": "GET List – no auth (guest)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has success=true', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "});",
                  "pm.test('Data is array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an('array');",
                  "});",
                  "pm.test('Meta contains pagination fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.meta).to.have.all.keys('page', 'limit', 'total', 'totalPages');",
                  "});",
                  "pm.test('Guest: no internal_notes in any item', () => {",
                  "  const body = pm.response.json();",
                  "  body.data.forEach(item => {",
                  "    pm.expect(item).to.not.have.property('internal_notes');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ip-assets?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["ip-assets"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET List – filter by asset_type=trademark",
          "event": [
