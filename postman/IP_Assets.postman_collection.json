                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "});",
                  "pm.test('Asset fields match request', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.asset_type).to.equal('trademark');",
                  "  pm.expect(data.title).to.equal('Nhãn hiệu Test Postman');",
                  "  pm.expect(data.application_number).to.equal('TM-2024-POSTMAN-001');",
                  "});",
                  "// Save created_asset_id for later tests",
                  "const id = pm.response.json().data?.id;",
                  "if (id) pm.collectionVariables.set('created_asset_id', id);"
                ]
              }
            }
